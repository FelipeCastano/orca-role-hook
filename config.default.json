{
  "settings": {
    "launchWaitSeconds": 15,
    "kickoffTimeoutSeconds": 180,
    "jiraHandoff": true,
    "closeComposerAgent": true,
    "composerAgentWindowSeconds": 180,
    "cleanWorkersAfterStep": true,
    "language": "auto"
  },
  "defaults": {
    "agent": "claude",
    "permissionMode": "auto",
    "mcp": [],
    "allowedTools": ["Bash(orca orchestration:*)", "Read"],
    "extraDirs": [],
    "extraArgs": [],
    "env": {},
    "params": {}
  },
  "mcpServers": {
    "atlassian": { "type": "sse", "url": "https://mcp.atlassian.com/v1/sse" },
    "context7": { "type": "http", "url": "https://mcp.context7.com/mcp" },
    "playwright": { "command": "npx", "args": ["-y", "@playwright/mcp@latest", "--headless", "--isolated",
                                              "--storage-state", "{browserState}", "--output-dir", "{worktree}/{evidenceDir}"] }
  },
  "roles": {
    "planner": {
      "title": "Planner",
      "enabled": true,
      "model": "claude-opus-5-5",
      "mcp": "all",
      "allowedTools": ["Bash(orca:*)", "Read"],
      "extraDirs": ["{kit}"],
      "pluginDirs": ["{kit}/plugin"]
    },
    "researcher": {
      "title": "Researcher",
      "enabled": true,
      "model": "claude-opus-5-5",
      "mcp": ["context7"]
    },
    "dev": {
      "title": "Dev",
      "enabled": true,
      "model": "claude-sonnet-5-5",
      "mcp": ["context7"]
    },
    "tester": {
      "title": "Tester",
      "enabled": true,
      "model": "claude-sonnet-5-5",
      "nice": 10,
      "env": { "OMP_NUM_THREADS": "2", "MKL_NUM_THREADS": "2", "OPENBLAS_NUM_THREADS": "2", "NUMEXPR_NUM_THREADS": "2", "VECLIB_MAXIMUM_THREADS": "2",
               "TOKENIZERS_PARALLELISM": "false", "GOMAXPROCS": "2", "RAYON_NUM_THREADS": "2", "CARGO_BUILD_JOBS": "2", "MAKEFLAGS": "-j2",
               "UV_THREADPOOL_SIZE": "2", "CUDA_VISIBLE_DEVICES": "" },
      "params": { "maxNewTests": 10, "maxWorkers": 2, "timeoutMinutes": 10, "maxSelfMutants": 5 }
    },
    "auditor": {
      "title": "Auditor",
      "enabled": true,
      "model": "claude-opus-5-5",
      "nice": 10,
      "env": { "OMP_NUM_THREADS": "2", "MKL_NUM_THREADS": "2", "OPENBLAS_NUM_THREADS": "2", "NUMEXPR_NUM_THREADS": "2", "VECLIB_MAXIMUM_THREADS": "2",
               "TOKENIZERS_PARALLELISM": "false", "GOMAXPROCS": "2", "RAYON_NUM_THREADS": "2", "CARGO_BUILD_JOBS": "2", "MAKEFLAGS": "-j2",
               "UV_THREADPOOL_SIZE": "2", "CUDA_VISIBLE_DEVICES": "" },
      "params": { "maxMutants": 15, "maxWorkers": 2, "rejectSeverity": "high" }
    },
    "e2e-tester": {
      "title": "E2E-Tester",
      "enabled": true,
      "model": "claude-opus-5-5",
      "mcp": ["playwright"],
      "params": { "evidenceDir": "qa-evidence" }
    },
    "deployer": {
      "title": "Deployer",
      "enabled": true,
      "model": "claude-sonnet-5-5"
    }
  }
}
