{
  "settings": {
    "launchWaitSeconds": 15,
    "kickoffTimeoutSeconds": 180,
    "jiraHandoff": true,
    "closeComposerAgent": true,
    "composerAgentWindowSeconds": 180,
    "cleanWorkersAfterStep": true,
    "language": "auto",
    "mode": "programmer",
    "oracle": { "enabled": false, "maxLoad": 0.8, "waitMax": 300, "timeout": 600, "retries": 1 },
    "sessionHook": true,
    "telemetry": { "roleAttribute": false },
    "metrics": { "enabled": true, "otlpEndpoint": "http://127.0.0.1:4318/v1/metrics", "prometheusUrl": "http://127.0.0.1:9090", "intervalSeconds": 60, "retentionDays": 90, "allowRemote": false },
    "enableAskModeOnStart": true,
    "superpowers": true,
    "prReviewer": { "marketplace": "romerox3/lens-review", "plugin": "lens-review@lens-review", "skill": "skills/lens-review/SKILL.md" }
  },
  "defaults": {
    "agent": "claude",
    "permissionMode": "auto",
    "mcp": [],
    "allowedTools": ["Bash(orca orchestration:*)", "Read"],
    "extraDirs": [],
    "extraArgs": [],
    "env": {},
    "params": {}
  },
  "mcpServers": {
    "atlassian": { "type": "sse", "url": "https://mcp.atlassian.com/v1/sse" },
    "context7": { "type": "http", "url": "https://mcp.context7.com/mcp" },
    "playwright": { "command": "{kit}/pw/node_modules/.bin/playwright-mcp",
                    "args": ["--browser", "chromium", "--headless", "--isolated",
                             "--storage-state", "{browserState}", "--output-dir", "{worktree}/{evidenceDir}"],
                    "env": { "PLAYWRIGHT_BROWSERS_PATH": "{kit}/browsers" } }
  },
  "roles": {
    "local-coordinator": {
      "title": "Local coordinator",
      "enabled": true,
      "modes": "all",
      "model": "claude-sonnet-5-5",
      "mcp": "all",
      "allowedTools": ["Bash(orca:*)", "Read"],
      "extraDirs": ["{kit}"],
      "pluginDirs": ["{kit}/plugin", "{kit}/plugins/superpowers"]
    },
    "planner": {
      "title": "Planner",
      "enabled": true,
      "modes": ["programmer", "academic-research"],
      "model": "claude-opus-5-5",
      "mcp": "all",
      "allowedTools": ["Bash(orca:*)", "Read"],
      "extraDirs": ["{kit}"],
      "pluginDirs": ["{kit}/plugin", "{kit}/plugins/superpowers"]
    },
    "researcher": {
      "title": "Researcher",
      "enabled": true,
      "modes": ["programmer", "academic-research"],
      "phases": ["experiment", "writing"],
      "model": "claude-opus-5-5",
      "mcp": ["context7"]
    },
    "dev": {
      "title": "Dev",
      "enabled": true,
      "modes": ["programmer", "academic-research"],
      "phases": ["experiment"],
      "model": "claude-sonnet-5-5",
      "mcp": ["context7"]
    },
    "tester": {
      "title": "Tester",
      "enabled": true,
      "modes": ["programmer", "academic-research"],
      "phases": ["experiment"],
      "model": "claude-sonnet-5-5",
      "nice": 10,
      "env": { "OMP_NUM_THREADS": "2", "MKL_NUM_THREADS": "2", "OPENBLAS_NUM_THREADS": "2", "NUMEXPR_NUM_THREADS": "2", "VECLIB_MAXIMUM_THREADS": "2",
               "TOKENIZERS_PARALLELISM": "false", "GOMAXPROCS": "2", "RAYON_NUM_THREADS": "2", "CARGO_BUILD_JOBS": "2", "MAKEFLAGS": "-j2",
               "UV_THREADPOOL_SIZE": "2", "CUDA_VISIBLE_DEVICES": "" },
      "params": { "maxNewTests": 10, "maxWorkers": 2, "timeoutMinutes": 10, "maxSelfMutants": 3, "baseCheck": true }
    },
    "auditor": {
      "title": "Auditor",
      "enabled": true,
      "modes": ["programmer", "pr-reviewer"],
      "model": "claude-opus-5-5",
      "nice": 10,
      "env": { "OMP_NUM_THREADS": "2", "MKL_NUM_THREADS": "2", "OPENBLAS_NUM_THREADS": "2", "NUMEXPR_NUM_THREADS": "2", "VECLIB_MAXIMUM_THREADS": "2",
               "TOKENIZERS_PARALLELISM": "false", "GOMAXPROCS": "2", "RAYON_NUM_THREADS": "2", "CARGO_BUILD_JOBS": "2", "MAKEFLAGS": "-j2",
               "UV_THREADPOOL_SIZE": "2", "CUDA_VISIBLE_DEVICES": "" },
      "params": { "maxMutants": 8, "maxWorkers": 2, "rejectSeverity": "high" }
    },
    "e2e-tester": {
      "title": "E2E-Tester",
      "enabled": true,
      "modes": ["programmer"],
      "model": "claude-opus-5-5",
      "mcp": ["playwright"],
      "params": { "evidenceDir": "qa-evidence", "e2eDir": "qa-e2e" }
    },
    "deployer": {
      "title": "Deployer",
      "enabled": true,
      "modes": ["programmer"],
      "model": "claude-sonnet-5-5"
    },
    "sota": {
      "title": "State-of-the-Art",
      "enabled": true,
      "modes": ["academic-research"],
      "phases": ["experiment"],
      "model": "claude-haiku-5-5"
    },
    "methodology": {
      "title": "Methodology",
      "enabled": true,
      "modes": ["academic-research"],
      "phases": ["experiment"],
      "model": "claude-opus-5-5"
    },
    "tech-verifier": {
      "title": "Tech-Verifier",
      "enabled": true,
      "modes": ["academic-research"],
      "phases": ["experiment"],
      "model": "claude-opus-5-5"
    },
    "writer": {
      "title": "Writer",
      "enabled": true,
      "modes": ["academic-research"],
      "phases": ["writing"],
      "model": "claude-sonnet-5-5"
    },
    "evidence": {
      "title": "Evidence",
      "enabled": true,
      "modes": ["academic-research"],
      "phases": ["writing"],
      "model": "claude-sonnet-5-5"
    },
    "rigor": {
      "title": "Rigor",
      "enabled": true,
      "modes": ["academic-research"],
      "phases": ["writing"],
      "model": "claude-opus-5-5"
    },
    "style": {
      "title": "Style",
      "enabled": true,
      "modes": ["academic-research"],
      "phases": ["writing"],
      "model": "claude-sonnet-5-5"
    },
    "dev-opencode": {
      "title": "Dev (OpenCode)",
      "description": "Dev's job (implements the step's code, writes no tests) run by an OpenCode model; give it Dev's tasks when the user asks for it",
      "enabled": false,
      "modes": ["programmer"],
      "agent": "opencode",
      "model": "",
      "common": "{kit}/prompts/programmer/common-peon.md",
      "prompt": { "programmer": "{kit}/prompts/programmer/dev.md" },
      "mcp": [],
      "opencode": { "steps": 120, "permissions": [] }
    },
    "cross-dev": {
      "title": "Cross-Dev",
      "description": "Writes an independent patch and tests for a step from Dev's spec, without seeing Dev's work, so the Tester can cross-check tests and patches; give it tasks only when your startup message turns the cross-check on",
      "enabled": false,
      "modes": ["programmer"],
      "agent": "opencode",
      "model": "",
      "common": "{kit}/prompts/programmer/common-peon.md",
      "nice": 10,
      "env": { "OMP_NUM_THREADS": "2", "MKL_NUM_THREADS": "2", "OPENBLAS_NUM_THREADS": "2", "NUMEXPR_NUM_THREADS": "2", "VECLIB_MAXIMUM_THREADS": "2",
               "TOKENIZERS_PARALLELISM": "false", "GOMAXPROCS": "2", "RAYON_NUM_THREADS": "2", "CARGO_BUILD_JOBS": "2", "MAKEFLAGS": "-j2",
               "UV_THREADPOOL_SIZE": "2", "CUDA_VISIBLE_DEVICES": "" },
      "params": { "maxNewTests": 10, "maxWorkers": 2, "timeoutMinutes": 10 },
      "mcp": [],
      "opencode": { "steps": 120, "permissions": [] }
    }
  }
}
