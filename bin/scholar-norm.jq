# norm: string -> comparable ASCII key
def fold:
  {"à":"a","á":"a","â":"a","ã":"a","ä":"a","å":"a","ā":"a","ă":"a","ą":"a","ç":"c","ć":"c","č":"c","ď":"d","đ":"d","è":"e","é":"e","ê":"e","ë":"e","ē":"e","ė":"e","ę":"e","ě":"e","ì":"i","í":"i","î":"i","ï":"i","ī":"i","ı":"i","ł":"l","ñ":"n","ń":"n","ň":"n","ò":"o","ó":"o","ô":"o","õ":"o","ö":"o","ø":"o","ō":"o","ő":"o","ř":"r","ś":"s","š":"s","ş":"s","ș":"s","ť":"t","ţ":"t","ț":"t","ù":"u","ú":"u","û":"u","ü":"u","ū":"u","ů":"u","ű":"u","ý":"y","ÿ":"y","ź":"z","ż":"z","ž":"z","ß":"ss","æ":"ae","œ":"oe","þ":"th","ð":"d","À":"a","Á":"a","Â":"a","Ã":"a","Ä":"a","Å":"a","Ā":"a","Ă":"a","Ą":"a","Ç":"c","Ć":"c","Č":"c","Ď":"d","Đ":"d","È":"e","É":"e","Ê":"e","Ë":"e","Ē":"e","Ė":"e","Ę":"e","Ě":"e","Ì":"i","Í":"i","Î":"i","Ï":"i","Ī":"i","Ł":"l","Ñ":"n","Ń":"n","Ň":"n","Ò":"o","Ó":"o","Ô":"o","Õ":"o","Ö":"o","Ø":"o","Ō":"o","Ő":"o","Ř":"r","Ś":"s","Š":"s","Ş":"s","Ș":"s","Ť":"t","Ţ":"t","Ț":"t","Ù":"u","Ú":"u","Û":"u","Ü":"u","Ū":"u","Ů":"u","Ű":"u","Ý":"y","Ÿ":"y","Ź":"z","Ż":"z","Ž":"z","ẞ":"ss","Æ":"ae","Œ":"oe","Þ":"th","Ð":"d"} as $m
  | explode | map([.] | implode | ($m[.] // .)) | join("");
def norm:
  gsub("<[^>]+>"; " ")                                   # JATS/HTML tags (<scp>, <i>, <sub>)
  | gsub("\\\\(?<a>[`'^\"~=.])\\s*\\{?(?<c>[A-Za-z])\\}?"; .c)   # \"u \'e \^o \~n \=a \.z
  | gsub("\\\\(?<a>[uvHtcdbkr])\\s*\\{(?<c>[A-Za-z])\\}"; .c)    # \v{c} \c{c} \H{o} \k{a}
  | gsub("\\\\ss\\b"; "ss") | gsub("\\\\(?<c>[oOlL])\\b"; .c) | gsub("\\\\(ae|AE)\\b"; "ae") | gsub("\\\\(oe|OE)\\b"; "oe") | gsub("\\\\i\\b"; "i")
  | gsub("\\\\[A-Za-z]+"; " ")                            # other LaTeX commands (\textit, \emph ...)
  | gsub("[{}$]"; "")                                     # TeX grouping and math delimiters
  | fold | ascii_downcase
  | gsub("[^a-z0-9]+"; " ") | gsub("^ +| +$"; "");
def lastname:   # BibTeX "Last, First" / "First Last" / display name -> last word of the normalized surname
  (if test(",") then split(",")[0] else . end) | norm | split(" ") | last // "";
