    {
      "id": 2,
      "type": "stat",
      "title": "Priced cost",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 0,
        "y": 1,
        "w": 6,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum(sum by (session_id) (max_over_time(claude_code_cost_usage_USD_total{task=~\"$task\", orca_roles_role=~\"$orca_roles_role\"}[$__range])))",
          "legendFormat": "",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "currencyUSD"
        },
        "overrides": []
      },
      "options": {},
      "description": "Sum of the cumulative cost of every session active in the range."
    },
    {
      "id": 3,
