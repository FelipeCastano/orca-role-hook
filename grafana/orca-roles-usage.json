          "expr": "sum(sum by (session_id) (max_over_time(orca_roles_cache_savings_USD{task=~\"$task\", orca_roles_role=~\"$orca_roles_role\"}[$__range])))",
          "legendFormat": "",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "currencyUSD"
        },
        "overrides": []
      },
      "options": {},
      "description": "Cache tokens priced as uncached input, minus what they cost."
    },
