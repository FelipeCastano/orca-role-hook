    {
      "id": 41,
      "type": "table",
      "title": "Cost against tokens per role and model",
      "description": "Tokens high: the spend comes from volume. Cost per million tokens high: from the model's price or a large share of output tokens; a large cache read share lowers it.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 12,
        "y": 21,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum by (orca_roles_role, model) (sum by (session_id, orca_roles_role, model) (max_over_time(claude_code_token_usage_tokens_total{task=~\"$task\", orca_roles_role=~\"$orca_roles_role\"}[$__range])))",
          "instant": true,
          "range": false,
          "format": "table"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum by (orca_roles_role, model) (sum by (session_id, orca_roles_role, model) (max_over_time(claude_code_cost_usage_USD_total{task=~\"$task\", orca_roles_role=~\"$orca_roles_role\"}[$__range])))",
          "instant": true,
          "range": false,
          "format": "table"
        },
        {
          "refId": "C",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "(sum by (orca_roles_role, model) (sum by (session_id, orca_roles_role, model) (max_over_time(claude_code_cost_usage_USD_total{task=~\"$task\", orca_roles_role=~\"$orca_roles_role\"}[$__range])))) / clamp_min((sum by (orca_roles_role, model) (sum by (session_id, orca_roles_role, model) (max_over_time(claude_code_token_usage_tokens_total{task=~\"$task\", orca_roles_role=~\"$orca_roles_role\"}[$__range])))), 1) * 1e6",
          "instant": true,
          "range": false,
          "format": "table"
        },
        {
          "refId": "D",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "(sum by (orca_roles_role, model) (sum by (session_id, orca_roles_role, model) (max_over_time(claude_code_token_usage_tokens_total{task=~\"$task\", orca_roles_role=~\"$orca_roles_role\", type=\"cacheRead\"}[$__range])))) / clamp_min((sum by (orca_roles_role, model) (sum by (session_id, orca_roles_role, model) (max_over_time(claude_code_token_usage_tokens_total{task=~\"$task\", orca_roles_role=~\"$orca_roles_role\"}[$__range])))), 1)",
          "instant": true,
          "range": false,
          "format": "table"
        }
      ],
      "transformations": [
        {
          "id": "merge",
          "options": {}
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true
            },
            "renameByName": {
              "orca_roles_role": "Role",
              "model": "Model",
              "Value #A": "Tokens",
              "Value #B": "Cost",
              "Value #C": "Cost per Mtok",
              "Value #D": "Cache read share"
            },
            "indexByName": {
              "orca_roles_role": 0,
              "model": 1,
              "Value #A": 2,
              "Value #B": 3,
              "Value #C": 4,
              "Value #D": 5
            }
          }
        },
        {
          "id": "sortBy",
          "options": {
